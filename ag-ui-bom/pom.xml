<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.agui</groupId>
        <artifactId>ag-ui-java-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ag-ui-bom</artifactId>
    <packaging>pom</packaging>

    <name>AG-UI Java - BOM (ag-ui-bom)</name>
    <description>Bill of Materials for AG-UI Core, A2A, LangChain4j, and Quarkus Adapter Modules</description>

    <dependencyManagement>
        <dependencies>
            <!-- Framework-Agnostic Core, Sessions, SSE/WebSocket Transports & MCP Bridge -->
            <dependency>
                <groupId>org.agui</groupId>
                <artifactId>ag-ui-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Framework-Agnostic A2A Protocol Bridge -->
            <dependency>
                <groupId>org.agui</groupId>
                <artifactId>ag-ui-a2a</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Framework-Agnostic Upstream LangChain4j TokenStream & Event Bridge -->
            <dependency>
                <groupId>org.agui</groupId>
                <artifactId>ag-ui-langchain4j</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Plain Quarkus CDI, Mutiny, WebSockets Next & Quarkiverse LangChain4j Adapter -->
            <dependency>
                <groupId>org.agui</groupId>
                <artifactId>ag-ui-quarkus</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
