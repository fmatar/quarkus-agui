{
  "name": "@agui/svelte",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "description": "Headless Svelte 5 Runes & JavaScript SDK for the AG-UI Protocol wrapping @ag-ui/client and @ag-ui/core with WebSocketAgent, RFC 6902 JSON Patch, and Tri-Protocol (AG-UI + MCP + A2A) wire telemetry.",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.4",
    "@ag-ui/core": "^1.0.4",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
